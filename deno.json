{
  "name": "radi",
  "version": "0.5.0",
  "tasks": {
    "docs:build": "deno run -A site/build.ts",
    "docs:preview": "deno run -A site/build.ts --serve",
    "test:docs": "deno test -A --config deno.server.json tests/docs-interaction_test.ts",
    "dev": "deno -A npm:esbuild playground/*.tsx --jsx-import-source=preact --jsx=automatic --watch --servedir=playground/www --outdir=playground/www --bundle",
    "test": "deno -A --unstable-bundle @marcisbee/rion/test.cli --includes src",
    "test:server": "deno test --config deno.server.json --allow-net=127.0.0.1 tests/server-runtime_test.tsx",
    "test:static": "deno test -A --config deno.server.json tests/static-site_test.ts",
    "test:router": "deno test -A --unstable-bundle --config deno.server.json tests/router_test.ts",
    "test:router:go": "deno test -A --config deno.server.json tests/router-go_test.ts",
    "bench:server": "deno run --config deno.server.json bench/server.ts",
    "bench": "deno -A --unstable-bundle @marcisbee/rion/bench.cli --includes src",
    "publish": "deno -A ./build.npm.ts && cd npm && npm publish --tag alpha"
  },
  "exports": {
    ".": "./src/client.ts",
    "./client": "./src/client.ts",
    "./resume": "./src/resume.ts",
    "./router": "./src/router.ts",
    "./server": "./src/server.ts",
    "./go": "./src/go.ts",
    "./static": "./src/static.ts",
    "./server/jsx-runtime": "./src/server/jsx-runtime.ts",
    "./server/jsx-dev-runtime": "./src/server/jsx-dev-runtime.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./renderer": "./src/renderer.ts",
    "./signal": "./src/signal.ts",
    "./channel": "./src/channel.ts",
    "./types": "./src/types.ts",
    "./symbols": "./src/symbols.ts"
  },
  "imports": {
    "@marcisbee/rion": "jsr:@marcisbee/rion@^0.5.0"
  }
}
