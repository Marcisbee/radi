{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "radi",
    "types": ["./node_modules/radi/jsx.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
